{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the settings window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:default",
    "dialog:default",
    "allow-get-config",
    "allow-list-monitors",
    "allow-get-state",
    "allow-set-monitor-wallpaper",
    "allow-set-monitor-fit",
    "allow-list-library",
    "allow-import-wallpaper",
    "allow-apply-library-wallpaper"
  ]
}
